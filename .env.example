# Переменные окружения — скопируй этот файл в .env и заполни значения
# НИКОГДА не коммить .env в git!

# OpenAI API Key (обязательно для ИИ-ассистента)
# Получить на: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...ваш-ключ...

# Порт сервера (по умолчанию 8080)
PORT=8080

# Путь к файлу меню (по умолчанию data/menu.json)
MENU_PATH=data/menu.json
